<?xml version="1.0"?>
<ruleset name="wazeka">
  <description>テーマの PHP を WordPress Coding Standards で検査する（インデントはスペース2）</description>
  <file>.</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>dist/*</exclude-pattern>
  <exclude-pattern>*.js</exclude-pattern>

  <arg name="extensions" value="php"/>
  <!-- WordPress-Core の既定は tab-width=4。スペース2と揃える。 -->
  <arg name="tab-width" value="2"/>

  <config name="minimum_supported_wp_version" value="6.0"/>

  <rule ref="WordPress">
    <exclude name="Generic.Files.LineLength"/>
    <exclude name="Generic.Files.LineEndings"/>
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <!-- 短配列 [] を許可。 -->
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
  </rule>

  <!-- WordPress-Core の ScopeIndent（indent=4・タブ）を上書きする。 -->
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="exact" value="true"/>
      <property name="indent" value="2"/>
      <property name="tabIndent" value="false"/>
      <property name="ignoreIndentationTokens" type="array">
        <element value="T_HEREDOC"/>
        <element value="T_NOWDOC"/>
        <element value="T_INLINE_HTML"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.Arrays.ArrayIndentation">
    <properties>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="wazeka"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="wazeka"/>
      </property>
    </properties>
  </rule>
</ruleset>
