{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]*(-[a-zA-Z0-9]+)*(__[a-zA-Z0-9]+)*(--[a-zA-Z0-9]+)*$",
      {
        "message": "Expected class selector to match FLOCSS/BEM (camelCase OK)"
      }
    ],
    "custom-property-pattern": null
  }
}
